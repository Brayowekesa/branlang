// Test for functions, conditionals, and loops

show("--- Function Test ---")
fn add(a, b):
  return a + b

mem result = add(10, 5)
show("Result of add(10, 5) is", result)
show("")

show("--- Conditional Test ---")
when result > 10:
  show("Result is greater than 10.")
otherwise:
  show("Result is not greater than 10.")
show("")

show("--- Loop Test ---")
mem i = 3
loop (i > 0):
  show("Countdown:", i)
  i = i - 1

show("Test complete!")